<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.Toolbar" parent="@style/Theme.PdfSignature">
        <item name="android:textColorPrimary">@color/textColor1</item>
        <item name="android:textColorSecondary">@color/textColor1</item>
    </style>
    <style name="Theme.PdfSignature" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorPrimary">@color/textColor3</item>
        <item name="colorPrimaryVariant">@color/textColor3</item>
        <item name="colorSecondary">@color/textColor3</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
    </style>

    <style name="CardViewCommon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">@dimen/_6sdp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="contentPadding">@dimen/_8sdp</item>
    </style>
    <style name="CardViewCommon2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="contentPadding">0dp</item>
    </style>
    <style name="DefaultAlertDialogTheme" parent="@style/Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColorSecondary">@color/colorPrimary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
    </style>
    <style name="ImageViewMedium" parent="@style/ImageViewSmall">
        <item name="android:layout_width">@dimen/_36sdp</item>
        <item name="android:layout_height">@dimen/_36sdp</item>
    </style>
    <style name="ImageViewSmall">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="android:layout_width">@dimen/_28sdp</item>
        <item name="android:layout_height">@dimen/_28sdp</item>
    </style>

    <style name="ToolbarTheme.Base" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/textColor1</item>
    </style>
    <style name="MyDarkToolbarStyle" parent="@style/ThemeOverlay.AppCompat.Light">
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColor">@color/textColor1</item>
    </style>


    <style name="TextViewBold" parent="@style/TextViewCommon">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/textColor1</item>
        <item name="android:fontFamily">@font/font_bold</item>
    </style>
    <style name="TextViewCommon">
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:textColor">@color/textColor1</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="TextViewRegular" parent="@style/TextViewCommon">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/textColor1</item>
        <item name="android:fontFamily">@font/font_regular</item>
    </style>
    <style name="TextViewSemiBold" parent="@style/TextViewCommon">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/textColor1</item>
        <item name="android:fontFamily">@font/font_semibold</item>
    </style>
    <style name="TextViewToolbarTitle" parent="@style/TextViewCommon">
        <item name="android:textSize">@dimen/_16sdp</item>
        <item name="android:fontFamily">@font/font_bold</item>
    </style>
</resources>
