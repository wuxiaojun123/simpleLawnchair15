<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="7dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true">

            <ImageView
                android:id="@+id/dialog_rating_icon"
                android:visibility="visible"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:src="@drawable/ic_rate_feedback"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerHorizontal="true" />

            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/rate_button_color"
                android:gravity="center"
                android:id="@+id/txt"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="15dp"
                android:text="Enjoying Fill &amp; Sign PDF Document?"
                android:layout_below="@+id/dialog_rating_icon"
                android:layout_centerHorizontal="true" />

            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/dialog_rating_title"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:text="Support us by giving rate and your precious review !!\10It will take few seconds only."
                android:layout_below="@+id/txt"
                android:layout_centerHorizontal="true" />

            <RatingBar
                android:id="@+id/dialog_rating_rating_bar"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:numStars="5"
                android:stepSize="1"
                android:layout_below="@+id/dialog_rating_title"
                android:layout_centerHorizontal="true"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:progressTint="@color/rate_active_color"
                android:progressBackgroundTint="@color/rate_normal_color" />

            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btn"
                android:background="@drawable/rate_button_blue"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:text="Rate now"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:id="@+id/bt_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btn">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:gravity="center_horizontal"
                        android:id="@+id/maybe"
                        android:padding="8dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maybe later" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:src="@drawable/ic_rate_feedback"
                android:layout_centerHorizontal="true" />

            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/dialog_rating_feedback_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:layout_below="@+id/icon"
                android:textAlignment="center" />

            <EditText
                android:textColorHint="@color/grey_400"
                android:gravity="top|left"
                android:id="@+id/dialog_rating_feedback"
                android:background="@drawable/edittext_background"
                android:padding="10dp"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:maxLines="10"
                android:lines="8"
                android:minLines="6"
                android:layout_below="@+id/dialog_rating_feedback_title"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_rating_feedback_buttons"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/dialog_rating_feedback">

                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="16dp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/dialog_rating_button_feedback_submit"
                    android:background="@drawable/rate_button_blue"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    android:text="Send"
                    android:layout_below="@+id/dialog_rating_rating_bar"
                    android:layout_centerHorizontal="true"
                    android:textAllCaps="false" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_horizontal"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/dialog_rating_button_feedback_submit">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="13sp"
                            android:gravity="center_horizontal"
                            android:id="@+id/dialog_rating_button_feedback_cancel"
                            android:padding="10dp"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maybe later" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/dialog_rating_buttons"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/dialog_rating_rating_bar">

                <TextView
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/dialog_rating_button_negative"
                    android:background="?attr/selectableItemBackground"
                    android:padding="15dp"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:textSize="15sp"
                    android:gravity="center"
                    android:id="@+id/dialog_rating_button_positive"
                    android:background="?attr/selectableItemBackground"
                    android:padding="15dp"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
