<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:orientation="vertical"
        android:tag="layout/activity_color_picker_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false">

            <androidx.appcompat.widget.AppCompatImageView
                android:src="@drawable/ic_back"
                style="@style/ImageViewSmall" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/_11sdp"
            android:id="@+id/mBtnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:text="save"
            android:fontFamily="@font/font_bold"
            android:layout_alignParentEnd="true"
            app:backgroundTint="@color/textColor3"
            app:cornerRadius="@dimen/_14sdp" />

        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/mBtnSave"
            android:layout_above="@id/banner1"
            android:layout_marginEnd="@dimen/_30sdp"
            android:layout_toEndOf="@+id/mcvBack">

            <com.skydoves.colorpickerview.ColorPickerView
                android:layout_gravity="center"
                android:id="@+id/colorPickerView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:layout_weight="1"
                app:initialColor="@color/white"
                app:preferenceName="Test2"
                app:selector="@drawable/wheel" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.2">

                <com.skydoves.colorpickerview.AlphaTileView
                    android:layout_gravity="center"
                    android:id="@+id/alphaTileView"
                    android:background="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"
                    app:tileSize="20" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/banner1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center">

            <RelativeLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:gravity="center" />

        </RelativeLayout>


    </RelativeLayout>
</layout>
