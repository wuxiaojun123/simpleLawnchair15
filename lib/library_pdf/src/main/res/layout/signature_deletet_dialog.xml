<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:tag="layout/signature_deletet_dialog_0"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvParentDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                app:cardBackgroundColor="@color/textColor3"
                app:cardCornerRadius="@dimen/_6sdp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="1dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:gravity="center"
                                android:id="@+id/txtTitle"
                                android:layout_width="match_parent"
                                android:layout_marginTop="@dimen/_22sdp"
                                android:text="Are you sure?"
                                style="@style/TextViewBold" />

                            <TextView
                                android:textColor="@color/textColor2"
                                android:gravity="center"
                                android:id="@+id/txtDescription"
                                android:layout_width="match_parent"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:layout_marginRight="@dimen/_10sdp"
                                android:layout_marginBottom="@dimen/_2sdp"
                                android:text="Do you really want to delete these signature?"
                                style="@style/TextViewRegular" />

                            <LinearLayout
                                android:orientation="horizontal"
                                android:background="@color/txtBackground"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardCancel"
                                    android:layout_width="@dimen/_100sdp"
                                    android:layout_height="@dimen/_35sdp"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="@dimen/_10sdp"
                                    app:cardCornerRadius="@dimen/_6sdp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:textSize="@dimen/_14sdp"
                                        android:textColor="@color/textColor1"
                                        android:gravity="center"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="Cancel"
                                        style="@style/TextViewBold" />
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardSave"
                                    android:layout_width="@dimen/_100sdp"
                                    android:layout_height="@dimen/_35sdp"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:layout_weight="1"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    app:cardBackgroundColor="@color/textColor3"
                                    app:cardCornerRadius="@dimen/_6sdp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:textSize="@dimen/_14sdp"
                                        android:textColor="@color/white"
                                        android:gravity="center"
                                        android:id="@+id/txtSave"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="Confirm"
                                        style="@style/TextViewBold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/mcvPro"
                android:background="@drawable/shape_oval"
                android:padding="@dimen/_8sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/textColor3"
                app:layout_constraintBottom_toTopOf="@+id/cvParentDelete"
                app:layout_constraintEnd_toEndOf="@+id/cvParentDelete"
                app:layout_constraintStart_toStartOf="@+id/cvParentDelete"
                app:layout_constraintTop_toTopOf="@+id/cvParentDelete">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgPro"
                    android:padding="0dp"
                    android:src="@drawable/ic_delete_black_24dp"
                    android:adjustViewBounds="true"
                    style="@style/ImageViewSmall" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>
