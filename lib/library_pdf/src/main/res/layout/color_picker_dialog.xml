<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:tag="layout/color_picker_dialog_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_15sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:gravity="center"
                            android:id="@+id/txtTitle"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="Choose Color"
                            style="@style/TextViewBold" />

                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.skydoves.colorpickerview.ColorPickerView
                                android:layout_gravity="center"
                                android:id="@+id/colorPickerView"
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:layout_marginBottom="@dimen/_10sdp"
                                app:initialColor="@color/white"
                                app:preferenceName="Test2"
                                app:selector="@drawable/wheel" />

                            <LinearLayout
                                android:layout_width="@dimen/_45sdp"
                                android:layout_height="@dimen/_40sdp">

                                <com.skydoves.colorpickerview.AlphaTileView
                                    android:layout_gravity="center"
                                    android:id="@+id/alphaTileView"
                                    android:background="@color/black"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:tileSize="20" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="@color/txtBackground"
                            android:padding="@dimen/_10sdp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardCancel"
                                android:layout_width="@dimen/_100sdp"
                                android:layout_height="@dimen/_35sdp"
                                android:foreground="?attr/selectableItemBackground"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/_10sdp"
                                app:cardCornerRadius="@dimen/_6sdp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:textSize="@dimen/_14sdp"
                                    android:textColor="@color/textColor1"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="Cancel"
                                    style="@style/TextViewBold" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardSave"
                                android:layout_width="@dimen/_100sdp"
                                android:layout_height="@dimen/_35sdp"
                                android:foreground="?attr/selectableItemBackground"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                app:cardBackgroundColor="@color/textColor3"
                                app:cardCornerRadius="@dimen/_6sdp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:textSize="@dimen/_14sdp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:id="@+id/txtSave"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="Select"
                                    style="@style/TextViewBold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</layout>
