<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDigital"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ToolbarTheme.Base"
        app:popupTheme="@style/MyDarkToolbarStyle"
        app:title=" " />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="?attr/actionBarSize">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mPdfSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:fontFamily="@font/font_bold"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textSize="@dimen/_11sdp"
            app:backgroundTint="@color/textColor3"
            app:cornerRadius="@dimen/_14sdp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/docviewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/banner1"
        android:layout_below="@+id/toolbarDigital">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.simplepdf.pdfeditor.Document.PDSViewPager
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/pageNumberOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginTop="@dimen/pagenumber_overlay_margin_top"
                android:background="@drawable/pagenumber_indicator_theme"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pageNumberTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pagenumber_left_margin"
                    android:layout_marginTop="@dimen/pagenumber_top_bottom_margin"
                    android:layout_marginEnd="@dimen/pagenumber_right_margin"
                    android:layout_marginBottom="@dimen/pagenumber_top_bottom_margin"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:padding="0dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textViewTextSize" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/savingProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="invisible" />
        </FrameLayout>


    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/fab_margin"
        android:layout_above="@+id/banner1"
        android:contentDescription="@string/app_name"
        app:backgroundTint="@color/textColor3"
        app:fabSize="normal"
        app:srcCompat="@drawable/edit"
        app:tint="@color/white" />


    <RelativeLayout
        android:id="@+id/banner1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:gravity="center" />

    </RelativeLayout>
</RelativeLayout>

